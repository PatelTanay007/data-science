   "source": [
    "def format_followers(n):\n",
    "    if n >= 1_000_000:\n",
    "        return f\"{n/1_000_000:.1f}M\"\n",
    "    elif n >= 1_000:\n",
    "        return f\"{n/1_000:.1f}K\"\n",
    "    return str(n)\n",
    "\n",
    "followers = [950, 1500, 25000, 1200000]\n",
    "print(list(map(format_followers, followers)))"
   ]
  },
