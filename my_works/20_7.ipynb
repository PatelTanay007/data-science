    "def format_price(price, currency='INR') :\n",
    "    if currency==\"INR\":\n",
    "        print(f\"₹{price}\")\n",
    "    elif currency==\"USD\":\n",
    "        print(f\"${price}\")\n",
    "    else:\n",
    "        print(\"please enter valid currency\")\n",
    "\n",
    "format_price(1499,\"USD\")"
   ]
  }
